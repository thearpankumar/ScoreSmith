# =====================================================================================================
# SECRETS: copy this file to infra/.env (git-ignored) and fill in YOUR OWN values. Nothing secret lives in the
# repo; docker compose refuses to start while POSTGRES_PASSWORD or JWT_SECRET is empty. Generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"     (DB password: URL-safe characters only)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"     (JWT_SECRET / BOOTSTRAP_TOKEN)
# Already have a local database volume created with an older password? Put THAT exact password in
# POSTGRES_PASSWORD (Postgres only reads it when it first initialises the volume), or change it in the database:
#   docker compose exec db psql -U qs_app -d quality_scorecard -c "ALTER USER qs_app PASSWORD '<new>'"
# =====================================================================================================

# Postgres
POSTGRES_USER=qs_app
POSTGRES_PASSWORD=
POSTGRES_DB=quality_scorecard
POSTGRES_PORT=5432
# Dedicated database for `pytest` (backend/tests/conftest.py), on the SAME Postgres
# service/instance as POSTGRES_DB above — created by infra/db-init/02-create-test-db.sql
# on a fresh volume (or manually: `CREATE DATABASE quality_scorecard_test;` against an
# already-initialized instance). Keeps the test suite's per-test TRUNCATE from ever
# touching the dev/demo database's seeded data. If unset, conftest.py derives it from
# DATABASE_URL by swapping the database name for `quality_scorecard_test`, so this only
# needs to be set explicitly for a non-default setup (e.g. CI, a separate DB host).
# Fill in the same password as POSTGRES_PASSWORD:
# TEST_DATABASE_URL=postgresql+psycopg://qs_app:<POSTGRES_PASSWORD>@localhost:5432/quality_scorecard_test
# TEST_REDIS_URL=redis://localhost:6379/0 enables the live Redis limiter tests in `pytest` (they are skipped when unset).
# Compose's Redis has no host port by design: start a throwaway one with `docker run -p 6379:6379 redis:7-alpine`.

# Backend
BACKEND_PORT=8000
# AWS credentials for Bedrock — use a local profile / SSO in dev, never commit real keys.
# NOTE (confirmed live 2026-09-29): if your credentials are an AWS Bedrock long-term "API
# key" (bearer-token credential) rather than a real SigV4 IAM access key/secret pair, using
# them as plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY fails with `UnrecognizedClientException:
# The security token included in the request is invalid`. Bedrock API keys must instead be
# passed via the AWS_BEARER_TOKEN_BEDROCK env var (botocore auto-prefers bearer auth for
# Bedrock when it's set — see botocore/handlers.py::get_bearer_auth_supported_services), and
# the value must be prefixed "A" (confirmed live: without it, Bedrock rejects with "Invalid
# API Key format: Must start with pre-defined prefix"). See docker-compose.yml's
# AWS_BEARER_TOKEN_BEDROCK line, which derives this automatically from AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL_ID=zai.glm-5
# Judge-only model: Z.ai GLM 4.7 Flash, confirmed live/directly-invocable on Bedrock,
# cheap/fast enough to justify the k=3-call ensemble judge (see backend/app/ai/judge.py).
BEDROCK_JUDGE_MODEL_ID=zai.glm-4.7-flash
# GLM-5 has no Bedrock embedding endpoint; Titan remains the embedding model for similarity search
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# OpenRouter JEV API Key
OPENROUTER_JEV_API=

# --- Authentication ---
# ENV selects the mode (ENVIRONMENT is accepted as an alias). Default: development.
#   ENV=production -> Secure cookies + HSTS, /docs hidden, public signup OFF by default, ADMIN_EMAIL/ADMIN_PASSWORD
#   IGNORED, and the api + worker REFUSE TO START unless JWT_SECRET (32+ random chars), a random 12+ char database
#   password, COOKIE_SECURE, explicit https CORS_ORIGINS / FRONTEND_URL and EMAIL_BACKEND=ses are all set.
# ENV=development
# Signs the 15-minute access tokens. REQUIRED (compose fails without it). Outside production an unset value only
# gives an ephemeral random key (sessions die on restart, and processes disagree) - always set it in .env.
JWT_SECRET=
# Double-submit CSRF uses a random per-session cookie, so there is no separate CSRF secret to configure.

# --- First admin ---
# DEVELOPMENT (ENV != production): set both and the api / worker create this admin on startup if no user has this
# email yet. It never resets an existing user's password (use `python -m app.scripts.set_password <email>
# --allow-weak` to change it). In development the password may be short (no strength policy) and the sign-in form
# also accepts the username ADMIN_USERNAME (default "admin") for the ADMIN_EMAIL account. None of this exists in
# production: there the email-format login and the 12/14-character password policies always apply.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# PRODUCTION (ENV=production): the two variables above are ignored. Set a one-time token, create the first admin
# once, then REMOVE the token (the endpoint also closes by itself as soon as any user exists):
#   curl -X POST https://<host>/api/v1/auth/register-user -H "Content-Type: application/json" \
#     -H "X-Bootstrap-Token: $BOOTSTRAP_TOKEN" -d '{"email":"admin@corp.com","name":"Admin","password":"<strong>"}'
# or open /setup in the web app. Afterwards admins create users with the same endpoint (signed in as admin).
# BOOTSTRAP_TOKEN=
# Public self-service signup: default ON in development, OFF in production.
# SIGNUP_ENABLED=true
# Public URL of the web app (links in password-reset / verify e-mails, CSRF Origin check) and allowed CORS origins.
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# E-mail: "log" prints reset / verification links in the API log (local dev); "ses" sends via Amazon SES.
# EMAIL_BACKEND=log
# EMAIL_FROM=
# OAuth sign-in (buttons stay disabled until BOTH values of a provider are set). Redirect URI to register with
# each provider: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/<google|github|microsoft>/callback
# OAUTH_REDIRECT_BASE=http://localhost:3000
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# Rate limits ("count/period"); Redis-backed when REDIS_URL is set. RATE_LIMIT_LOGIN=10/minute, RATE_LIMIT_SIGNUP=5/minute,
# RATE_LIMIT_FORGOT=5/hour, RATE_LIMIT_CHAT=30/minute, RATE_LIMIT_AI_JOBS=20/minute, RATE_LIMIT_EXPORT=10/minute

# --- Scaling (all optional; defaults suit a single local container) ---
# ROLE: api (HTTP only) | worker (python -m app.worker) | all (both in one process, the default).
# docker-compose.yml sets it per service. REDIS_URL turns on the cluster-wide Bedrock/Jev/search limits;
# leave it empty to use per-process limits only. It also falls back to them if Redis is down.
# ROLE=all
# REDIS_URL=
# LOG_FORMAT=text|json
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# WEB_CONCURRENCY=2
# BEDROCK_GLOBAL_CONCURRENCY=0   # 0 = same as BEDROCK_MAX_CONCURRENCY, but counted across ALL containers
# AUTOSCALE_METRIC_NAMESPACE=    # set to publish BacklogPerWorker to CloudWatch

# Frontend
FRONTEND_PORT=3000
# Where the Next.js server reaches the backend (the /api/v1/* proxy, session renewal in the middleware, and
# Server Components). Under docker-compose that is the service name; for `npm run dev` on the host use
# http://localhost:8000. The browser never sees this: it only calls the frontend's own origin.
INTERNAL_API_BASE_URL=http://backend:8000

# AgentCore Gateway Web Search — the `web_search` tool bound in the chat scorecard
# builder's propose_kpis node (see backend/app/ai/web_search.py). This is the ONLY web
# search backend in this project: no Firecrawl/DuckDuckGo fallback is configured or
# needed. If any of the four vars below are unset, web_search.py treats the client as
# "not configured" and simply returns no results (never fails the chat turn).
AGENTCORE_GATEWAY_WEB_SEARCH_URL=
AGENTCORE_GATEWAY_WEB_SEARCH_TOOL_NAME=
AGENTCORE_GATEWAY_AWS_ACCESS_KEY_ID=
AGENTCORE_GATEWAY_AWS_SECRET_ACCESS_KEY=

# AI evaluation pipeline (file / Google Drive submissions) - see docs/ai-eval-contract.md.
# S3_BUCKET, SFN_STATE_MACHINE_ARN and the APP keys below are written by `aws/bootstrap` (never commit
# real values). The APP keys belong to the dedicated IAM user `qs-backend-app` (S3 + Step Functions only);
# they are NOT the Bedrock bearer token and are the only credentials the S3/SFN boto3 clients use.
S3_BUCKET=
SFN_STATE_MACHINE_ARN=
AWS_APP_ACCESS_KEY_ID=
AWS_APP_SECRET_ACCESS_KEY=
# Max evaluations processed at once (clamped to 1-5).
AI_EVAL_MAX_CONCURRENT=3
BEDROCK_MASTER_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0

# --- Advanced tunables (all optional; the defaults in backend/app/config.py are fine for local dev) ---
# Cookies / API docs / proxy: COOKIE_SECURE (default: on in production), COOKIE_SAMESITE=lax, COOKIE_DOMAIN=,
#   DOCS_ENABLED (default: off in production), FORWARDED_ALLOW_IPS (proxies whose X-Forwarded-For is trusted;
#   docker-compose defaults it to the private ranges so per-IP rate limits see the real client, not the Next.js proxy)
# Sessions: JWT_ALGORITHM=HS256, ACCESS_TOKEN_MINUTES=15, REFRESH_DAYS_REMEMBER=30, REFRESH_HOURS_SESSION=24,
#   REFRESH_REUSE_GRACE_SECONDS=10, PASSWORD_MIN_LENGTH=12, PASSWORD_MAX_LENGTH=128, ADMIN_PASSWORD_MIN_LENGTH=14,
#   LOCKOUT_THRESHOLD=5, LOCKOUT_BASE_MINUTES=5, LOCKOUT_MAX_MINUTES=60, PASSWORD_RESET_TTL_MINUTES=60,
#   EMAIL_VERIFY_TTL_HOURS=48
# Rate limits: RATE_LIMIT_ENABLED=true, RATE_LIMIT_RESET=10/hour, RATE_LIMIT_REFRESH=60/minute,
#   RATE_LIMIT_UPLOADS=30/minute, RATE_LIMIT_REGISTER_USER=5/minute, RATE_LIMIT_SHARE_LOOKUP=20/hour (invitation / share
#   attempts per SENDER, bounds username probing), RATE_LIMIT_SHARE=60/minute, RATE_LIMIT_ADMIN=60/minute
# Leases / workers: LEASE_SECONDS=60, LEASE_HEARTBEAT_SECONDS=15, CHAT_SUPERVISOR_SECONDS=2, CHAT_TURN_MAX_CONCURRENT=8,
#   WORKER_HEALTH_PORT=8001, WORKER_DRAIN_GRACE_SECONDS=20, CHAT_TURN_TIMEOUT_SECONDS=900
# DB pool: DB_POOL_RECYCLE_SECONDS=1800, DB_POOL_TIMEOUT_SECONDS=30
# Redis limits: JEV_GLOBAL_CONCURRENCY=0, WEB_SEARCH_GLOBAL_CONCURRENCY=0, REDIS_SLOT_LEASE_SECONDS=600,
#   REDIS_RETRY_AFTER_SECONDS=10, AUTOSCALE_METRIC_INTERVAL_SECONDS=60
# Evaluations: AI_EVAL_POLL_SECONDS=4, AI_EVAL_TIMEOUT_SECONDS=14400, AI_EVAL_SCORING_RETRIES=2,
#   AI_EVAL_SCORING_RETRY_DELAYS=[20,60] (seconds waited before each scoring retry; JSON list),
#   UPLOAD_MAX_BYTES=2147483648, UPLOAD_MAX_FILES=10, UPLOAD_PART_SIZE=33554432, UPLOAD_URL_TTL_SECONDS=900,
#   UPLOAD_USER_DAILY_BYTES=21474836480
# Trash: TRASH_RETENTION_DAYS=30 (days a deleted chart stays restorable in the owner's trash before it is purged for good)
# Chat builder budgets: USER_KPIS_PER_FILL_CALL=5, USER_RESEARCH_TIMEOUT_SECONDS=45, USER_ENRICH_DEADLINE_SECONDS=170,
#   OPEN_FILL_DEADLINE_SECONDS=150 (after these budgets, research is dropped and remaining KPIs get model-knowledge guidelines),
#   QUALITY_GATE_CALL_TIMEOUT_SECONDS=12 (per Jev call; a slow call counts as passed), QUALITY_GATE_BUDGET_SECONDS=150
#   (per turn; after it no further gate work starts)
# Full table of every variable: docs/configuration.md
# Test-only switches (set by the pytest suite, never in a real deployment): CHAT_TURNS_INLINE, AI_EVAL_INLINE
# Model/latency knobs: BEDROCK_MAX_OUTPUT_TOKENS, BEDROCK_READ_TIMEOUT_SECONDS, BEDROCK_CONNECT_TIMEOUT_SECONDS,
#   BEDROCK_MAX_ATTEMPTS, BEDROCK_MAX_POOL_CONNECTIONS, REQUEST_ROUTER=auto, OPENROUTER_JEV_MODEL_ID
