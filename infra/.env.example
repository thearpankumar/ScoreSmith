# Postgres
POSTGRES_USER=qs_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=quality_scorecard
POSTGRES_PORT=5432
# Dedicated database for `pytest` (backend/tests/conftest.py), on the SAME Postgres
# service/instance as POSTGRES_DB above — created by infra/db-init/02-create-test-db.sql
# on a fresh volume (or manually: `CREATE DATABASE quality_scorecard_test;` against an
# already-initialized instance). Keeps the test suite's per-test TRUNCATE from ever
# touching the dev/demo database's seeded data. If unset, conftest.py derives it from
# DATABASE_URL by swapping the database name for `quality_scorecard_test`, so this only
# needs to be set explicitly for a non-default setup (e.g. CI, a separate DB host).
TEST_DATABASE_URL=postgresql+psycopg://qs_app:change_me_locally@localhost:5432/quality_scorecard_test

# Backend
BACKEND_PORT=8000
# LLM provider: "openrouter" (default). "bedrock" is the legacy rollback path (needs AWS creds).
LLM_PROVIDER=openrouter
# OpenRouter API key (chat / judge / master / embeddings / web search). Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL_ID=openai/gpt-6-luna
OPENROUTER_JUDGE_MODEL_ID=deepseek/deepseek-v4.1-flash
OPENROUTER_MASTER_MODEL_ID=openai/gpt-6-luna
# Embeddings are requested with dimensions=1024 to match the pgvector column.
OPENROUTER_EMBEDDING_MODEL_ID=openai/text-embedding-3-small
# Model used with OpenRouter's `web` plugin for the chat builder's web_search tool.
OPENROUTER_SEARCH_MODEL_ID=openai/gpt-6-luna
# "low" by default (cheap/fast structured output); empty = do not send a reasoning setting.
OPENROUTER_REASONING_EFFORT=low
# Web-search plugin engine (e.g. native, exa); empty = OpenRouter default.
OPENROUTER_WEB_SEARCH_ENGINE=
AWS_REGION=us-east-1

# OpenRouter JEV (quality gate) API key; falls back to OPENROUTER_API_KEY when empty
OPENROUTER_JEV_API=

JWT_SECRET=change_me_locally

# Frontend
FRONTEND_PORT=3000
# Used by browser-side (client component) fetches — the backend as seen from the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used by server-side (Server Component / route handler) fetches running inside the
# frontend container — the backend as seen over the Compose network (service name, not
# localhost). Only relevant when running under docker-compose.
INTERNAL_API_BASE_URL=http://backend:8000

# AI evaluation pipeline (file / Google Drive submissions) - see docs/ai-eval-contract.md.
# The OR_* values are written by the OpenRouter-stack `aws/` bootstrap (never commit real values). The
# APP keys belong to a dedicated IAM user (S3 + Step Functions only) and are the only credentials the
# S3/SFN boto3 clients use. These OR_* names are read exclusively (no fallback to the old S3_BUCKET /
# SFN_STATE_MACHINE_ARN / AWS_APP_* names), so the old Bedrock stack can never be used by accident.
OR_S3_BUCKET=
OR_SFN_STATE_MACHINE_ARN=
OR_AWS_APP_ACCESS_KEY_ID=
OR_AWS_APP_SECRET_ACCESS_KEY=
# Max evaluations processed at once (clamped to 1-5).
AI_EVAL_MAX_CONCURRENT=3
