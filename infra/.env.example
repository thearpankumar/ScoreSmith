# Postgres
POSTGRES_USER=qs_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=quality_scorecard
POSTGRES_PORT=5432
# Dedicated database for `pytest` (backend/tests/conftest.py), on the SAME Postgres
# service/instance as POSTGRES_DB above — created by infra/db-init/02-create-test-db.sql
# on a fresh volume (or manually: `CREATE DATABASE quality_scorecard_test;` against an
# already-initialized instance). Keeps the test suite's per-test TRUNCATE from ever
# touching the dev/demo database's seeded data. If unset, conftest.py derives it from
# DATABASE_URL by swapping the database name for `quality_scorecard_test`, so this only
# needs to be set explicitly for a non-default setup (e.g. CI, a separate DB host).
TEST_DATABASE_URL=postgresql+psycopg://qs_app:change_me_locally@localhost:5432/quality_scorecard_test

# Backend
BACKEND_PORT=8000
# AWS credentials for Bedrock — use a local profile / SSO in dev, never commit real keys.
# NOTE (confirmed live 2026-09-29): if your credentials are an AWS Bedrock long-term "API
# key" (bearer-token credential) rather than a real SigV4 IAM access key/secret pair, using
# them as plain AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY fails with `UnrecognizedClientException:
# The security token included in the request is invalid`. Bedrock API keys must instead be
# passed via the AWS_BEARER_TOKEN_BEDROCK env var (botocore auto-prefers bearer auth for
# Bedrock when it's set — see botocore/handlers.py::get_bearer_auth_supported_services), and
# the value must be prefixed "A" (confirmed live: without it, Bedrock rejects with "Invalid
# API Key format: Must start with pre-defined prefix"). See docker-compose.yml's
# AWS_BEARER_TOKEN_BEDROCK line, which derives this automatically from AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL_ID=zai.glm-5
# Judge-only model: Z.ai GLM 4.7 Flash, confirmed live/directly-invocable on Bedrock,
# cheap/fast enough to justify the k=3-call ensemble judge (see backend/app/ai/judge.py).
BEDROCK_JUDGE_MODEL_ID=zai.glm-4.7-flash
# GLM-5 has no Bedrock embedding endpoint; Titan remains the embedding model for similarity search
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# OpenRouter JEV API Key
OPENROUTER_JEV_API=

JWT_SECRET=change_me_locally

# Frontend
FRONTEND_PORT=3000
# Used by browser-side (client component) fetches — the backend as seen from the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used by server-side (Server Component / route handler) fetches running inside the
# frontend container — the backend as seen over the Compose network (service name, not
# localhost). Only relevant when running under docker-compose.
INTERNAL_API_BASE_URL=http://backend:8000

# AgentCore Gateway Web Search — the `web_search` tool bound in the chat scorecard
# builder's propose_kpis node (see backend/app/ai/web_search.py). This is the ONLY web
# search backend in this project: no Firecrawl/DuckDuckGo fallback is configured or
# needed. If any of the four vars below are unset, web_search.py treats the client as
# "not configured" and simply returns no results (never fails the chat turn).
AGENTCORE_GATEWAY_WEB_SEARCH_URL=
AGENTCORE_GATEWAY_WEB_SEARCH_TOOL_NAME=
AGENTCORE_GATEWAY_AWS_ACCESS_KEY_ID=
AGENTCORE_GATEWAY_AWS_SECRET_ACCESS_KEY=
