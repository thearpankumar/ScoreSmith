        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-transcribe-chunk",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-transcribe-chunk:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-analyze-image",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-analyze-image:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-assemble",
