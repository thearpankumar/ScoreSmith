{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-ingest",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-ingest:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-extract-doc",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-extract-doc:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-plan-audio",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-plan-audio:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-transcribe-chunk",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-transcribe-chunk:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-analyze-image",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-analyze-image:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-assemble",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${PREFIX}-assemble:*"
      ]
    }
  ]
}
