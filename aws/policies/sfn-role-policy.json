        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-extract-doc",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-extract-doc:*",
        "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:qs-eval-plan-audio",
